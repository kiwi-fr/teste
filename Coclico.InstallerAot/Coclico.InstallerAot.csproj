<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PublishAot>true</PublishAot>
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
    <PublishTrimmed>true</PublishTrimmed>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <TrimMode>full</TrimMode>
    <!-- Optimisations taille du binaire natif : symboles stripés, pas d'ICU embarqué, pas de stack traces/debugger -->
    <StripSymbols>true</StripSymbols>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <StackTraceSupport>false</StackTraceSupport>
    <DebuggerSupport>false</DebuggerSupport>
    <EventSourceSupport>false</EventSourceSupport>
    <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <IlcGenerateStackTraceData>false</IlcGenerateStackTraceData>
    <!-- NU1903 : Tmds.DBus.Protocol n'est plus référencé directement ; la version transitive vient d'Avalonia.Desktop
         et n'est jamais utilisée à l'exécution (installeur Windows uniquement). -->
    <NoWarn>$(NoWarn);IL3053;NU1903</NoWarn>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <RootNamespace>Coclico.Installer</RootNamespace>
    <AssemblyName>Coclico.Installer</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\Coclico\Resources\icone\plage.ico</ApplicationIcon>
    <Product>Coclico Setup</Product>
    <Description>Installeur Coclico — Avalonia NativeAOT</Description>
    <Copyright>© $([System.DateTime]::UtcNow.Year) Coclico</Copyright>

    <SatelliteResourceLanguages>fr</SatelliteResourceLanguages>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <TrimmerRootAttribute Include="System.Reflection.AssemblyInformationalVersionAttribute" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.8" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.95.2" />
    <ProjectReference Include="..\Coclico.Security\Coclico.Security.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="payload.zip" Condition="Exists('payload.zip')">
      <LogicalName>Coclico.Installer.payload.zip</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Assets\ai-models.json">
      <LogicalName>Coclico.Installer.Assets.ai-models.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\Coclico\Security\trust-policy.json">
      <LogicalName>Coclico.Installer.trust-policy.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
    <ItemGroup>
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="2.88.9" GeneratePathProperty="true" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Win32" Version="8.3.1.1" GeneratePathProperty="true" />
    <!-- ANGLE retire : aucun UseAngle dans le code, l'installeur rend en Skia logiciel -->
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(PkgSkiaSharp_NativeAssets_Win32)\runtimes\win-x64\native\libSkiaSharp.dll" LogicalName="libSkiaSharp.dll" Link="NativeLibs\libSkiaSharp.dll" />
    <EmbeddedResource Include="$(PkgHarfBuzzSharp_NativeAssets_Win32)\runtimes\win-x64\native\libHarfBuzzSharp.dll" LogicalName="libHarfBuzzSharp.dll" Link="NativeLibs\libHarfBuzzSharp.dll" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Resources\plage.png" Condition="Exists('Resources\plage.png')" />
  </ItemGroup>

</Project>
