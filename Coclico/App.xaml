<?xml version="1.0" encoding="utf-8"?>
<Application x:Class="Coclico.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Coclico.Converters"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">
  <Application.Resources>
      <ResourceDictionary>
          <ResourceDictionary.MergedDictionaries>
              <ui:ThemesDictionary Theme="Dark" />
              <ui:ControlsDictionary />
              <ResourceDictionary Source="/Coclico;component/Resources/Lang/fr.xaml" />
          </ResourceDictionary.MergedDictionaries>

          <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
          <BooleanToVisibilityConverter x:Key="BoolToVis"/>
          <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
          <converters:InverseBoolToVisibilityConverter x:Key="BoolToVisInv"/>
          <converters:FileIconConverter x:Key="FileIconConverter"/>
          <converters:FileIconConverter x:Key="IconConv"/>
          <converters:HexToBrushConverter x:Key="HexToBrush"/>
          <converters:FirstCharConverter x:Key="FirstCharConverter"/>
          <converters:EqualityToBoolConverter x:Key="EqualityToBoolConverter"/>
          <SolidColorBrush x:Key="BgSidebarBrush" Color="#0A0B0F" po:Freeze="True"/>
          <SolidColorBrush x:Key="BorderAccentBrush" Color="#FF5722" po:Freeze="True"/>
          <SolidColorBrush x:Key="BorderAccentSecondaryBrush" Color="#FFA000" po:Freeze="True"/>
          <Color x:Key="AccentPrimary">#FF453A</Color>
          <Color x:Key="AccentSecondary">#FFA000</Color>
          <Color x:Key="AccentCyan">#FF6B35</Color>
          <sys:Double x:Key="GlobalFontSize">13</sys:Double>
          <sys:Double x:Key="Space4">4</sys:Double>
          <sys:Double x:Key="Space2">2</sys:Double>
          <Thickness x:Key="CardPadding">20,18,20,18</Thickness>
          <Duration x:Key="MotionComponent">0:0:0.20</Duration>
          <Duration x:Key="MotionPage">0:0:0.30</Duration>

          <CornerRadius x:Key="CornerCard">16</CornerRadius>
          <CornerRadius x:Key="CornerBtn">11</CornerRadius>
          <CornerRadius x:Key="CornerSmall">8</CornerRadius>
          <CornerRadius x:Key="CornerPill">999</CornerRadius>
          <CornerRadius x:Key="CornerNode">8</CornerRadius>

          <RadialGradientBrush x:Key="BgBaseBrush" GradientOrigin="0.82,0.08" Center="0.82,0.08" RadiusX="1.15" RadiusY="1.15" po:Freeze="True">
              <GradientStop Color="#221016" Offset="0"/>
              <GradientStop Color="#120D13" Offset="0.28"/>
              <GradientStop Color="#0A0B11" Offset="0.62"/>
              <GradientStop Color="#060709" Offset="1"/>
          </RadialGradientBrush>
          <SolidColorBrush x:Key="BgPanelBrush"       Color="#E60B0C12" po:Freeze="True"/>
          <SolidColorBrush x:Key="BgSurfaceBrush"     Color="#D8101319" po:Freeze="True"/>
          <SolidColorBrush x:Key="BgCardBrush"        Color="#C9131722" po:Freeze="True"/>
          <SolidColorBrush x:Key="BgElevatedBrush"    Color="#E01A1F2C" po:Freeze="True"/>
          <SolidColorBrush x:Key="BgHoverBrush"       Color="#2A2434" po:Freeze="True"/>

          <SolidColorBrush x:Key="BorderSubtleBrush"  Color="#14FFFFFF" po:Freeze="True"/>
          <SolidColorBrush x:Key="BorderDefaultBrush" Color="#26FFFFFF" po:Freeze="True"/>
          <SolidColorBrush x:Key="BorderStrongBrush"  Color="#40FFFFFF" po:Freeze="True"/>

          <SolidColorBrush x:Key="TextPrimaryBrush"   Color="#FFFFFF" po:Freeze="True"/>
          <SolidColorBrush x:Key="TextSecondaryBrush" Color="#E4DDD8" po:Freeze="True"/>
          <SolidColorBrush x:Key="TextMutedBrush"     Color="#ABA39C" po:Freeze="True"/>
          <SolidColorBrush x:Key="TextHintBrush"      Color="#8F8880" po:Freeze="True"/>
          <SolidColorBrush x:Key="TextAccentBrush"    Color="#FF6B35" po:Freeze="True"/>
          <SolidColorBrush x:Key="PrimaryBrush"    Color="#FF453A" po:Freeze="True"/>
          <SolidColorBrush x:Key="SecondaryBrush"  Color="#FFA000" po:Freeze="True"/>
          <SolidColorBrush x:Key="AccentPrimaryBrush" Color="#FF453A" po:Freeze="True"/>
          <SolidColorBrush x:Key="AccentCyanBrush" Color="#FF6B35" po:Freeze="True"/>
          <SolidColorBrush x:Key="SuccessBrush"    Color="#10B981" po:Freeze="True"/>
          <SolidColorBrush x:Key="CyanBrush"       Color="#FF6B35" po:Freeze="True"/>
          <SolidColorBrush x:Key="WarnBrush"       Color="#FFA000" po:Freeze="True"/>
          <SolidColorBrush x:Key="DangerBrush"     Color="#FF3B30" po:Freeze="True"/>

          <SolidColorBrush x:Key="ArchitecturalYellowBrush" Color="#FFA000" po:Freeze="True"/>
          <SolidColorBrush x:Key="ArchitecturalAmberBrush"  Color="#FF8A50" po:Freeze="True"/>
          <SolidColorBrush x:Key="ArchitecturalDarkTextBrush" Color="#07080B" po:Freeze="True"/>

          <SolidColorBrush x:Key="OverlayLight"      Color="#0AFFFFFF" po:Freeze="True"/>
          <SolidColorBrush x:Key="OverlayDark"       Color="#E607080B" po:Freeze="True"/>
          <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,0">
              <GradientStop Color="#FF4136" Offset="0"/>
              <GradientStop Color="#FF7A1F" Offset="0.55"/>
              <GradientStop Color="#FFB020" Offset="1"/>
          </LinearGradientBrush>

          <LinearGradientBrush x:Key="CyberGradient" StartPoint="0,0" EndPoint="1,0">
              <GradientStop Color="#E11D48" Offset="0"/>
              <GradientStop Color="#FF5722" Offset="1"/>
          </LinearGradientBrush>

          <LinearGradientBrush x:Key="FoxGradient" StartPoint="0,0" EndPoint="1,0">
              <GradientStop Color="#E63946" Offset="0"/>
              <GradientStop Color="#FF6B35" Offset="0.5"/>
              <GradientStop Color="#FFA000" Offset="1"/>
          </LinearGradientBrush>

          <LinearGradientBrush x:Key="EclipseGlowGradient" StartPoint="0.5,0" EndPoint="0.5,1">
              <GradientStop Color="#33FF5722" Offset="0"/>
              <GradientStop Color="#0007080B" Offset="1"/>
          </LinearGradientBrush>

          <LinearGradientBrush x:Key="GradRam" StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#6366F1" Offset="0"/>
              <GradientStop Color="#8B5CF6" Offset="1"/>
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="GradCleaning" StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#059669" Offset="0"/>
              <GradientStop Color="#10B981" Offset="1"/>
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="GradPrograms" StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#D97706" Offset="0"/>
              <GradientStop Color="#F59E0B" Offset="1"/>
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="GradInstaller" StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#0284C7" Offset="0"/>
              <GradientStop Color="#38BDF8" Offset="1"/>
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="GradHealth" StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#4338CA" Offset="0"/>
              <GradientStop Color="#6366F1" Offset="1"/>
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="GradNetwork" StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#BE123C" Offset="0"/>
              <GradientStop Color="#F43F5E" Offset="1"/>
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="GradZen" StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#0369A1" Offset="0"/>
              <GradientStop Color="#38BDF8" Offset="1"/>
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="GradGamer" StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#9F1239" Offset="0"/>
              <GradientStop Color="#F43F5E" Offset="1"/>
          </LinearGradientBrush>
          <LinearGradientBrush x:Key="GradWork" StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#065F46" Offset="0"/>
              <GradientStop Color="#10B981" Offset="1"/>
          </LinearGradientBrush>

          <CubicEase   x:Key="EaseOut"        EasingMode="EaseOut"/>
          <CubicEase   x:Key="EaseIn"         EasingMode="EaseIn"/>
          <CubicEase   x:Key="EaseInOut"      EasingMode="EaseInOut"/>
          <BackEase    x:Key="EaseBack"       EasingMode="EaseOut" Amplitude="0.25"/>
          <BackEase    x:Key="SpringEaseOut"  EasingMode="EaseOut" Amplitude="0.28"/>
          <BackEase    x:Key="SpringBounce"   EasingMode="EaseOut" Amplitude="0.35"/>
          <QuarticEase x:Key="SmoothEaseOut"  EasingMode="EaseOut"/>

          <SolidColorBrush x:Key="AccentBrush"   Color="#FF453A" po:Freeze="True"/>
          <Style x:Key="RedSunCard" TargetType="Border">
              <Setter Property="Background" Value="{DynamicResource BgCardBrush}"/>
              <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
              <Setter Property="BorderThickness" Value="1"/>
              <Setter Property="CornerRadius" Value="{StaticResource CornerCard}"/>
              <Setter Property="Padding" Value="18,16"/>
              <Setter Property="SnapsToDevicePixels" Value="True"/>
          </Style>

          <Style x:Key="CoclicoPanel" TargetType="Border" BasedOn="{StaticResource RedSunCard}"/>

          <Style x:Key="CoclicoPageTitle" TargetType="TextBlock">
              <Setter Property="FontSize" Value="27"/>
              <Setter Property="FontWeight" Value="Bold"/>
              <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
              <Setter Property="Margin" Value="0,0,0,4"/>
          </Style>

          <Style x:Key="SectionTitle" TargetType="TextBlock">
              <Setter Property="FontSize"   Value="17"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
              <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
              <Setter Property="Margin"     Value="0,0,0,4"/>
          </Style>

          <Style TargetType="TextBlock">
              <Setter Property="FontSize"   Value="{DynamicResource GlobalFontSize}"/>
              <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI Variable, Segoe UI, sans-serif"/>
              <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
              <Setter Property="RenderOptions.ClearTypeHint"  Value="Enabled"/>
          </Style>

          <Style x:Key="PrimaryButton" TargetType="Button">
              <Setter Property="Cursor"                     Value="Hand"/>
              <Setter Property="Foreground"                 Value="#0A0A0C"/>
              <Setter Property="FontWeight"                 Value="Bold"/>
              <Setter Property="FontSize"                   Value="12.5"/>
              <Setter Property="Padding"                    Value="16,8"/>
              <Setter Property="BorderThickness"            Value="0"/>
              <Setter Property="SnapsToDevicePixels"        Value="True"/>
              <Setter Property="RenderTransformOrigin"      Value="0.5,0.5"/>
              <Setter Property="Template">
                  <Setter.Value>
                      <ControlTemplate TargetType="Button">
                          <Border x:Name="Bd"
                                  Background="{DynamicResource PrimaryGradient}"
                                  CornerRadius="{StaticResource CornerBtn}"
                                  Padding="{TemplateBinding Padding}"
                                  SnapsToDevicePixels="True">
                              <Border.RenderTransform>
                                  <ScaleTransform x:Name="BtnScale" ScaleX="1" ScaleY="1"/>
                              </Border.RenderTransform>
                              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Border>
                          <ControlTemplate.Triggers>
                              <Trigger Property="IsEnabled" Value="False">
                                  <Setter TargetName="Bd" Property="Opacity" Value="0.38"/>
                              </Trigger>
                              <EventTrigger RoutedEvent="Button.MouseEnter">
                                  <BeginStoryboard>
                                      <Storyboard>
                                          <DoubleAnimation Storyboard.TargetName="BtnScale"
                                                           Storyboard.TargetProperty="ScaleX"
                                                           To="1.025" Duration="0:0:0.14"
                                                           EasingFunction="{StaticResource SpringEaseOut}"/>
                                          <DoubleAnimation Storyboard.TargetName="BtnScale"
                                                           Storyboard.TargetProperty="ScaleY"
                                                           To="1.025" Duration="0:0:0.14"
                                                           EasingFunction="{StaticResource SpringEaseOut}"/>
                                      </Storyboard>
                                  </BeginStoryboard>
                              </EventTrigger>
                              <EventTrigger RoutedEvent="Button.MouseLeave">
                                  <BeginStoryboard>
                                      <Storyboard>
                                          <DoubleAnimation Storyboard.TargetName="BtnScale"
                                                           Storyboard.TargetProperty="ScaleX"
                                                           To="1" Duration="0:0:0.14"
                                                           EasingFunction="{StaticResource SmoothEaseOut}"/>
                                          <DoubleAnimation Storyboard.TargetName="BtnScale"
                                                           Storyboard.TargetProperty="ScaleY"
                                                           To="1" Duration="0:0:0.14"
                                                           EasingFunction="{StaticResource SmoothEaseOut}"/>
                                      </Storyboard>
                                  </BeginStoryboard>
                              </EventTrigger>
                              <EventTrigger RoutedEvent="Button.PreviewMouseLeftButtonDown">
                                  <BeginStoryboard>
                                      <Storyboard>
                                          <DoubleAnimation Storyboard.TargetName="BtnScale"
                                                           Storyboard.TargetProperty="ScaleX"
                                                           To="0.96" Duration="0:0:0.07"/>
                                          <DoubleAnimation Storyboard.TargetName="BtnScale"
                                                           Storyboard.TargetProperty="ScaleY"
                                                           To="0.96" Duration="0:0:0.07"/>
                                      </Storyboard>
                                  </BeginStoryboard>
                              </EventTrigger>
                              <EventTrigger RoutedEvent="Button.PreviewMouseLeftButtonUp">
                                  <BeginStoryboard>
                                      <Storyboard>
                                          <DoubleAnimation Storyboard.TargetName="BtnScale"
                                                           Storyboard.TargetProperty="ScaleX"
                                                           To="1" Duration="0:0:0.22"
                                                           EasingFunction="{StaticResource SpringBounce}"/>
                                          <DoubleAnimation Storyboard.TargetName="BtnScale"
                                                           Storyboard.TargetProperty="ScaleY"
                                                           To="1" Duration="0:0:0.22"
                                                           EasingFunction="{StaticResource SpringBounce}"/>
                                      </Storyboard>
                                  </BeginStoryboard>
                              </EventTrigger>
                              <Trigger Property="IsMouseOver" Value="True">
                                  <Setter TargetName="Bd" Property="Opacity" Value="0.92"/>
                              </Trigger>
                          </ControlTemplate.Triggers>
                      </ControlTemplate>
                  </Setter.Value>
              </Setter>
          </Style>

          <Style x:Key="ArchitecturalActionCard" TargetType="Button">
              <Setter Property="Cursor"                     Value="Hand"/>
              <Setter Property="Foreground"                 Value="#0A0A0C"/>
              <Setter Property="FontWeight"                 Value="Bold"/>
              <Setter Property="BorderThickness"            Value="0"/>
              <Setter Property="SnapsToDevicePixels"        Value="True"/>
              <Setter Property="RenderTransformOrigin"      Value="0.5,0.5"/>
              <Setter Property="Background"                 Value="{DynamicResource ArchitecturalYellowBrush}"/>
              <Setter Property="Template">
                  <Setter.Value>
                      <ControlTemplate TargetType="Button">
                          <Border x:Name="Bd"
                                  Background="{TemplateBinding Background}"
                                  CornerRadius="8"
                                  Padding="{TemplateBinding Padding}"
                                  SnapsToDevicePixels="True">
                              <Border.Effect>
                                  <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270" Color="#FFC700" Opacity="0.25"/>
                              </Border.Effect>
                              <Border.RenderTransform>
                                  <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
                              </Border.RenderTransform>
                              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                          </Border>
                          <ControlTemplate.Triggers>
                              <Trigger Property="IsEnabled" Value="False">
                                  <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                              </Trigger>
                              <Trigger Property="IsMouseOver" Value="True">
                                  <Setter TargetName="Bd" Property="Background" Value="#FFD633"/>
                              </Trigger>
                              <EventTrigger RoutedEvent="Button.MouseEnter">
                                  <BeginStoryboard>
                                      <Storyboard>
                                          <DoubleAnimation Storyboard.TargetName="CardScale"
                                                           Storyboard.TargetProperty="ScaleX"
                                                           To="1.018" Duration="0:0:0.14"
                                                           EasingFunction="{StaticResource SpringEaseOut}"/>
                                          <DoubleAnimation Storyboard.TargetName="CardScale"
                                                           Storyboard.TargetProperty="ScaleY"
                                                           To="1.018" Duration="0:0:0.14"
                                                           EasingFunction="{StaticResource SpringEaseOut}"/>
                                      </Storyboard>
                                  </BeginStoryboard>
                              </EventTrigger>
                              <EventTrigger RoutedEvent="Button.MouseLeave">
                                  <BeginStoryboard>
                                      <Storyboard>
                                          <DoubleAnimation Storyboard.TargetName="CardScale"
                                                           Storyboard.TargetProperty="ScaleX"
                                                           To="1" Duration="0:0:0.14"
                                                           EasingFunction="{StaticResource SmoothEaseOut}"/>
                                          <DoubleAnimation Storyboard.TargetName="CardScale"
                                                           Storyboard.TargetProperty="ScaleY"
                                                           To="1" Duration="0:0:0.14"
                                                           EasingFunction="{StaticResource SmoothEaseOut}"/>
                                      </Storyboard>
                                  </BeginStoryboard>
                              </EventTrigger>
                              <EventTrigger RoutedEvent="Button.PreviewMouseLeftButtonDown">
                                  <BeginStoryboard>
                                      <Storyboard>
                                          <DoubleAnimation Storyboard.TargetName="CardScale"
                                                           Storyboard.TargetProperty="ScaleX"
                                                           To="0.97" Duration="0:0:0.07"/>
                                          <DoubleAnimation Storyboard.TargetName="CardScale"
                                                           Storyboard.TargetProperty="ScaleY"
                                                           To="0.97" Duration="0:0:0.07"/>
                                      </Storyboard>
                                  </BeginStoryboard>
                              </EventTrigger>
                              <EventTrigger RoutedEvent="Button.PreviewMouseLeftButtonUp">
                                  <BeginStoryboard>
                                      <Storyboard>
                                          <DoubleAnimation Storyboard.TargetName="CardScale"
                                                           Storyboard.TargetProperty="ScaleX"
                                                           To="1" Duration="0:0:0.2"
                                                           EasingFunction="{StaticResource SpringBounce}"/>
                                          <DoubleAnimation Storyboard.TargetName="CardScale"
                                                           Storyboard.TargetProperty="ScaleY"
                                                           To="1" Duration="0:0:0.2"
                                                           EasingFunction="{StaticResource SpringBounce}"/>
                                      </Storyboard>
                                  </BeginStoryboard>
                              </EventTrigger>
                          </ControlTemplate.Triggers>
                      </ControlTemplate>
                  </Setter.Value>
              </Setter>
          </Style>

          <Style x:Key="SecondaryButton" TargetType="Button">
              <Setter Property="Cursor"                Value="Hand"/>
              <Setter Property="Foreground"            Value="{DynamicResource TextSecondaryBrush}"/>
              <Setter Property="FontWeight"            Value="SemiBold"/>
              <Setter Property="Padding"               Value="18,9"/>
              <Setter Property="BorderThickness"       Value="1"/>
              <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
              <Setter Property="Template">
                  <Setter.Value>
                      <ControlTemplate TargetType="Button">
                          <Border x:Name="Bd"
                                  Background="{DynamicResource BgElevatedBrush}"
                                  BorderBrush="{DynamicResource BorderDefaultBrush}"
                                  BorderThickness="1"
                                  CornerRadius="{StaticResource CornerBtn}"
                                  Padding="{TemplateBinding Padding}">
                              <Border.RenderTransform>
                                  <ScaleTransform x:Name="BtnScale" ScaleX="1" ScaleY="1"/>
                              </Border.RenderTransform>
                              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Border>
                          <ControlTemplate.Triggers>
                              <Trigger Property="IsEnabled" Value="False">
                                  <Setter TargetName="Bd" Property="Opacity" Value="0.38"/>
                              </Trigger>
                              <EventTrigger RoutedEvent="Button.MouseEnter">
                                  <BeginStoryboard>
                                      <Storyboard>
                                          <DoubleAnimation Storyboard.TargetName="BtnScale"
                                                           Storyboard.TargetProperty="ScaleX"
                                                           To="1.02" Duration="0:0:0.15"
                                                           EasingFunction="{StaticResource EaseOut}"/>
                                          <DoubleAnimation Storyboard.TargetName="BtnScale"
                                                           Storyboard.TargetProperty="ScaleY"
                                                           To="1.02" Duration="0:0:0.15"
                                                           EasingFunction="{StaticResource EaseOut}"/>
                                      </Storyboard>
                                  </BeginStoryboard>
                              </EventTrigger>
                              <EventTrigger RoutedEvent="Button.MouseLeave">
                                  <BeginStoryboard>
                                      <Storyboard>
                                          <DoubleAnimation Storyboard.TargetName="BtnScale"
                                                           Storyboard.TargetProperty="ScaleX"
                                                           To="1" Duration="0:0:0.15"
                                                           EasingFunction="{StaticResource EaseOut}"/>
                                          <DoubleAnimation Storyboard.TargetName="BtnScale"
                                                           Storyboard.TargetProperty="ScaleY"
                                                           To="1" Duration="0:0:0.15"
                                                           EasingFunction="{StaticResource EaseOut}"/>
                                      </Storyboard>
                                  </BeginStoryboard>
                              </EventTrigger>
                              <EventTrigger RoutedEvent="Button.PreviewMouseLeftButtonDown">
                                  <BeginStoryboard>
                                      <Storyboard>
                                          <DoubleAnimation Storyboard.TargetName="BtnScale"
                                                           Storyboard.TargetProperty="ScaleX"
                                                           To="0.97" Duration="0:0:0.08"/>
                                          <DoubleAnimation Storyboard.TargetName="BtnScale"
                                                           Storyboard.TargetProperty="ScaleY"
                                                           To="0.97" Duration="0:0:0.08"/>
                                      </Storyboard>
                                  </BeginStoryboard>
                              </EventTrigger>
                              <EventTrigger RoutedEvent="Button.PreviewMouseLeftButtonUp">
                                  <BeginStoryboard>
                                      <Storyboard>
                                          <DoubleAnimation Storyboard.TargetName="BtnScale"
                                                           Storyboard.TargetProperty="ScaleX"
                                                           To="1" Duration="0:0:0.20"
                                                           EasingFunction="{StaticResource EaseBack}"/>
                                          <DoubleAnimation Storyboard.TargetName="BtnScale"
                                                           Storyboard.TargetProperty="ScaleY"
                                                           To="1" Duration="0:0:0.20"
                                                           EasingFunction="{StaticResource EaseBack}"/>
                                      </Storyboard>
                                  </BeginStoryboard>
                              </EventTrigger>
                              <Trigger Property="IsMouseOver" Value="True">
                                  <Setter TargetName="Bd" Property="Background"   Value="{DynamicResource BgHoverBrush}"/>
                                  <Setter TargetName="Bd" Property="BorderBrush"  Value="{DynamicResource BorderStrongBrush}"/>
                                  <Setter Property="Foreground"                   Value="{DynamicResource TextPrimaryBrush}"/>
                              </Trigger>
                          </ControlTemplate.Triggers>
                      </ControlTemplate>
                  </Setter.Value>
              </Setter>
          </Style>

          <Style x:Key="GhostButton" TargetType="Button">
              <Setter Property="Cursor"          Value="Hand"/>
              <Setter Property="Foreground"      Value="{DynamicResource TextMutedBrush}"/>
              <Setter Property="FontWeight"      Value="Medium"/>
              <Setter Property="Padding"         Value="14,8"/>
              <Setter Property="BorderThickness" Value="1"/>
              <Setter Property="Template">
                  <Setter.Value>
                      <ControlTemplate TargetType="Button">
                          <Border x:Name="Bd"
                                  Background="Transparent"
                                  BorderBrush="{DynamicResource BorderSubtleBrush}"
                                  BorderThickness="1"
                                  CornerRadius="{StaticResource CornerSmall}"
                                  Padding="{TemplateBinding Padding}">
                              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Border>
                          <ControlTemplate.Triggers>
                              <Trigger Property="IsMouseOver" Value="True">
                                  <Setter TargetName="Bd" Property="Background"  Value="{DynamicResource BgCardBrush}"/>
                                  <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
                                  <Setter Property="Foreground"                  Value="{DynamicResource TextSecondaryBrush}"/>
                              </Trigger>
                              <Trigger Property="IsPressed" Value="True">
                                  <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgElevatedBrush}"/>
                              </Trigger>
                              <Trigger Property="IsEnabled" Value="False">
                                  <Setter TargetName="Bd" Property="Opacity" Value="0.38"/>
                              </Trigger>
                          </ControlTemplate.Triggers>
                      </ControlTemplate>
                  </Setter.Value>
              </Setter>
          </Style>

          <Style x:Key="DangerButton" TargetType="Button">
              <Setter Property="Cursor"          Value="Hand"/>
              <Setter Property="Foreground"      Value="White"/>
              <Setter Property="FontWeight"      Value="SemiBold"/>
              <Setter Property="Padding"         Value="18,9"/>
              <Setter Property="BorderThickness" Value="0"/>
              <Setter Property="Template">
                  <Setter.Value>
                      <ControlTemplate TargetType="Button">
                          <Border x:Name="Bd"
                                  Background="{DynamicResource DangerBrush}"
                                  CornerRadius="{StaticResource CornerBtn}"
                                  Padding="{TemplateBinding Padding}">
                              <Border.RenderTransform>
                                  <ScaleTransform x:Name="BtnScale" ScaleX="1" ScaleY="1"/>
                              </Border.RenderTransform>
                              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Border>
                          <ControlTemplate.Triggers>
                              <Trigger Property="IsEnabled" Value="False">
                                  <Setter TargetName="Bd" Property="Opacity" Value="0.38"/>
                              </Trigger>
                              <EventTrigger RoutedEvent="Button.MouseEnter">
                                  <BeginStoryboard>
                                      <Storyboard>
                                          <DoubleAnimation Storyboard.TargetName="BtnScale"
                                                           Storyboard.TargetProperty="ScaleX"
                                                           To="1.03" Duration="0:0:0.15"
                                                           EasingFunction="{StaticResource EaseOut}"/>
                                          <DoubleAnimation Storyboard.TargetName="BtnScale"
                                                           Storyboard.TargetProperty="ScaleY"
                                                           To="1.03" Duration="0:0:0.15"
                                                           EasingFunction="{StaticResource EaseOut}"/>
                                      </Storyboard>
                                  </BeginStoryboard>
                              </EventTrigger>
                              <EventTrigger RoutedEvent="Button.MouseLeave">
                                  <BeginStoryboard>
                                      <Storyboard>
                                          <DoubleAnimation Storyboard.TargetName="BtnScale"
                                                           Storyboard.TargetProperty="ScaleX"
                                                           To="1" Duration="0:0:0.15"
                                                           EasingFunction="{StaticResource EaseOut}"/>
                                          <DoubleAnimation Storyboard.TargetName="BtnScale"
                                                           Storyboard.TargetProperty="ScaleY"
                                                           To="1" Duration="0:0:0.15"
                                                           EasingFunction="{StaticResource EaseOut}"/>
                                      </Storyboard>
                                  </BeginStoryboard>
                              </EventTrigger>
                              <EventTrigger RoutedEvent="Button.PreviewMouseLeftButtonDown">
                                  <BeginStoryboard>
                                      <Storyboard>
                                          <DoubleAnimation Storyboard.TargetName="BtnScale"
                                                           Storyboard.TargetProperty="ScaleX"
                                                           To="0.96" Duration="0:0:0.08"/>
                                          <DoubleAnimation Storyboard.TargetName="BtnScale"
                                                           Storyboard.TargetProperty="ScaleY"
                                                           To="0.96" Duration="0:0:0.08"/>
                                      </Storyboard>
                                  </BeginStoryboard>
                              </EventTrigger>
                              <EventTrigger RoutedEvent="Button.PreviewMouseLeftButtonUp">
                                  <BeginStoryboard>
                                      <Storyboard>
                                          <DoubleAnimation Storyboard.TargetName="BtnScale"
                                                           Storyboard.TargetProperty="ScaleX"
                                                           To="1" Duration="0:0:0.22"
                                                           EasingFunction="{StaticResource EaseBack}"/>
                                          <DoubleAnimation Storyboard.TargetName="BtnScale"
                                                           Storyboard.TargetProperty="ScaleY"
                                                           To="1" Duration="0:0:0.22"
                                                           EasingFunction="{StaticResource EaseBack}"/>
                                      </Storyboard>
                                  </BeginStoryboard>
                              </EventTrigger>
                          </ControlTemplate.Triggers>
                      </ControlTemplate>
                  </Setter.Value>
              </Setter>
          </Style>

          <Style x:Key="NavItemStyle" TargetType="RadioButton">
              <Setter Property="Background"                 Value="Transparent"/>
              <Setter Property="Foreground"                 Value="{DynamicResource TextSecondaryBrush}"/>
              <Setter Property="FontSize"                   Value="{DynamicResource GlobalFontSize}"/>
              <Setter Property="FontWeight"                 Value="Medium"/>
              <Setter Property="Padding"                    Value="11,9"/>
              <Setter Property="Margin"                     Value="7,2"/>
              <Setter Property="HorizontalContentAlignment" Value="Left"/>
              <Setter Property="Cursor"                     Value="Hand"/>
              <Setter Property="SnapsToDevicePixels"        Value="True"/>
              <Setter Property="Template">
                  <Setter.Value>
                      <ControlTemplate TargetType="RadioButton">
                          <Grid>

                              <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                      CornerRadius="{StaticResource CornerSmall}"
                                      Padding="{TemplateBinding Padding}"
                                      SnapsToDevicePixels="True">
                                  <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                    VerticalAlignment="Center"
                                                    RecognizesAccessKey="False"/>
                              </Border>

                              <Border x:Name="Indicator" Width="4" Height="24" HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      CornerRadius="2" Visibility="Collapsed"
                                      Margin="0,0,0,0">
                                  <Border.Background>
                                      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                          <GradientStop x:Name="NavigationWaveBlue" Color="#FF453A" Offset="0.05"/>
                                          <GradientStop Color="#FF6B35" Offset="0.48"/>
                                          <GradientStop x:Name="NavigationWaveRed" Color="#FFA000" Offset="0.95"/>
                                      </LinearGradientBrush>
                                  </Border.Background>
                              </Border>
                          </Grid>
                          <ControlTemplate.Triggers>
                              <Trigger Property="IsMouseOver" Value="True">
                                  <Setter TargetName="Bd" Property="Background"  Value="{DynamicResource BgHoverBrush}"/>
                                  <Setter Property="Foreground"                  Value="{DynamicResource TextPrimaryBrush}"/>
                              </Trigger>
                              <Trigger Property="IsChecked" Value="True">
                                  <Setter TargetName="Bd"        Property="Background"      Value="#26FF6B35"/>
                                  <Setter TargetName="Bd"        Property="BorderThickness" Value="1"/>
                                  <Setter TargetName="Bd"        Property="BorderBrush"     Value="#4DFF6B35"/>
                                  <Setter TargetName="Indicator" Property="Visibility"      Value="Visible"/>
                                  <Setter Property="Foreground"  Value="{DynamicResource TextPrimaryBrush}"/>
                                  <Setter Property="FontWeight"  Value="SemiBold"/>
                                  <Trigger.EnterActions>
                                      <BeginStoryboard>
                                          <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                              <DoubleAnimation Storyboard.TargetName="NavigationWaveBlue"
                                                               Storyboard.TargetProperty="Offset" From="0.05" To="0.55"
                                                               Duration="0:0:1.8"/>
                                              <DoubleAnimation Storyboard.TargetName="NavigationWaveRed"
                                                               Storyboard.TargetProperty="Offset" From="0.55" To="0.95"
                                                               Duration="0:0:1.8"/>
                                          </Storyboard>
                                      </BeginStoryboard>
                                  </Trigger.EnterActions>
                              </Trigger>
                          </ControlTemplate.Triggers>
                      </ControlTemplate>
                  </Setter.Value>
              </Setter>
          </Style>

          <Style x:Key="PillBadge" TargetType="Border">
              <Setter Property="Background"      Value="{DynamicResource BgElevatedBrush}"/>
              <Setter Property="BorderBrush"     Value="{DynamicResource BorderDefaultBrush}"/>
              <Setter Property="BorderThickness" Value="1"/>
              <Setter Property="CornerRadius"    Value="{StaticResource CornerPill}"/>
              <Setter Property="Padding"         Value="8,3"/>
              <Setter Property="SnapsToDevicePixels" Value="True"/>
          </Style>

          <sys:Double x:Key="FontSmall">11</sys:Double>
          <Thickness x:Key="PageMargin">28,20,28,16</Thickness>

          <SolidColorBrush x:Key="SuccessBgBrush" Color="#1710B981" po:Freeze="True"/>
          <SolidColorBrush x:Key="SuccessBorderBrush" Color="#3310B981" po:Freeze="True"/>
          <SolidColorBrush x:Key="WarnBgBrush" Color="#17FFA000" po:Freeze="True"/>
          <SolidColorBrush x:Key="WarnBorderBrush" Color="#33FFA000" po:Freeze="True"/>
          <SolidColorBrush x:Key="DangerBgBrush" Color="#17FF3B30" po:Freeze="True"/>
          <SolidColorBrush x:Key="DangerBorderBrush" Color="#33FF3B30" po:Freeze="True"/>
          <SolidColorBrush x:Key="InfoBorderBrush" Color="#33FF8A50" po:Freeze="True"/>
          <SolidColorBrush x:Key="SkeletonBrush" Color="#252A38" po:Freeze="True"/>

          <SolidColorBrush x:Key="InfoBlueBrush"        Color="#38BDF8" po:Freeze="True"/>
          <SolidColorBrush x:Key="InfoBlueBgBrush"      Color="#1A38BDF8" po:Freeze="True"/>
          <SolidColorBrush x:Key="InfoBlueBorderBrush"  Color="#3338BDF8" po:Freeze="True"/>
          <SolidColorBrush x:Key="VioletBgBrush"        Color="#1A6366F1" po:Freeze="True"/>
          <SolidColorBrush x:Key="VioletBorderBrush"    Color="#336366F1" po:Freeze="True"/>
          <SolidColorBrush x:Key="VioletTextBrush"      Color="#C4B5FD" po:Freeze="True"/>
          <SolidColorBrush x:Key="SuccessDeepBgBrush"   Color="#0D2E1A" po:Freeze="True"/>
          <SolidColorBrush x:Key="SuccessDeepBorderBrush" Color="#166534" po:Freeze="True"/>
          <SolidColorBrush x:Key="AccentGlowBgBrush"    Color="#26FF6B35" po:Freeze="True"/>
          <SolidColorBrush x:Key="OverlayBlackBrush"    Color="#CC000000" po:Freeze="True"/>
          <SolidColorBrush x:Key="OverlayDangerBrush"   Color="#E008050F" po:Freeze="True"/>
          <SolidColorBrush x:Key="OverlaySoftBrush"     Color="#20FFFFFF" po:Freeze="True"/>

          <Style x:Key="PageHeaderAccentBar" TargetType="Border">
              <Setter Property="Width" Value="4"/>
              <Setter Property="Height" Value="28"/>
              <Setter Property="CornerRadius" Value="2"/>
              <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
              <Setter Property="Margin" Value="0,0,10,0"/>
              <Setter Property="VerticalAlignment" Value="Center"/>
              <Setter Property="SnapsToDevicePixels" Value="True"/>
          </Style>

          <Style x:Key="PageHeaderSubtitle" TargetType="TextBlock">
              <Setter Property="FontSize" Value="{StaticResource FontSmall}"/>
              <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
              <Setter Property="TextWrapping" Value="Wrap"/>
          </Style>

          <Style x:Key="PageEyebrow" TargetType="TextBlock">
              <Setter Property="FontSize"   Value="10.5"/>
              <Setter Property="FontWeight" Value="Bold"/>
              <Setter Property="Foreground" Value="{DynamicResource TextHintBrush}"/>
              <Setter Property="VerticalAlignment" Value="Center"/>
              <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
          </Style>

          <Style x:Key="PageEyebrowDot" TargetType="Border">
              <Setter Property="Width" Value="3"/>
              <Setter Property="Height" Value="3"/>
              <Setter Property="CornerRadius" Value="1.5"/>
              <Setter Property="Background" Value="{DynamicResource TextHintBrush}"/>
              <Setter Property="Margin" Value="0,0,8,0"/>
              <Setter Property="VerticalAlignment" Value="Center"/>
          </Style>

          <Style x:Key="PageBadge" TargetType="Border">
              <Setter Property="Background"      Value="{DynamicResource BgElevatedBrush}"/>
              <Setter Property="BorderBrush"     Value="{DynamicResource BorderDefaultBrush}"/>
              <Setter Property="BorderThickness" Value="1"/>
              <Setter Property="CornerRadius"    Value="{StaticResource CornerPill}"/>
              <Setter Property="Padding"         Value="10,4"/>
              <Setter Property="SnapsToDevicePixels" Value="True"/>
          </Style>

          <Style x:Key="MetricValue" TargetType="TextBlock">
              <Setter Property="FontSize"   Value="26"/>
              <Setter Property="FontWeight" Value="Bold"/>
              <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
              <Setter Property="VerticalAlignment" Value="Center"/>
          </Style>

          <Style x:Key="MetricLabel" TargetType="TextBlock">
              <Setter Property="FontSize"   Value="9.5"/>
              <Setter Property="FontWeight" Value="Bold"/>
              <Setter Property="Foreground" Value="{DynamicResource TextHintBrush}"/>
          </Style>

          <Style x:Key="LiveDot" TargetType="Border">
              <Setter Property="Width" Value="7"/>
              <Setter Property="Height" Value="7"/>
              <Setter Property="CornerRadius" Value="{StaticResource CornerPill}"/>
              <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
              <Setter Property="SnapsToDevicePixels" Value="True"/>
              <Style.Triggers>
                  <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                      <BeginStoryboard>
                          <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                              <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.35" Duration="0:0:0.9"/>
                          </Storyboard>
                      </BeginStoryboard>
                  </EventTrigger>
              </Style.Triggers>
          </Style>

          <Style x:Key="GlassCard" TargetType="Border">
              <Setter Property="Background"      Value="{DynamicResource BgCardBrush}"/>
              <Setter Property="BorderBrush"     Value="{DynamicResource BorderSubtleBrush}"/>
              <Setter Property="BorderThickness" Value="1"/>
              <Setter Property="CornerRadius"    Value="{DynamicResource CornerCard}"/>
              <Setter Property="Padding"         Value="22,20"/>
              <Setter Property="SnapsToDevicePixels" Value="True"/>
              <Style.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                      <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
                  </Trigger>
              </Style.Triggers>
          </Style>

          <Style x:Key="IconTile" TargetType="Border">
              <Setter Property="Width"         Value="34"/>
              <Setter Property="Height"        Value="34"/>
              <Setter Property="CornerRadius"  Value="10"/>
              <Setter Property="Background"    Value="{DynamicResource BgElevatedBrush}"/>
              <Setter Property="BorderBrush"   Value="{DynamicResource BorderSubtleBrush}"/>
              <Setter Property="BorderThickness" Value="1"/>
              <Setter Property="SnapsToDevicePixels" Value="True"/>
          </Style>

          <Style x:Key="CatRow" TargetType="Border">
              <Setter Property="Background"      Value="{DynamicResource BgSurfaceBrush}"/>
              <Setter Property="BorderBrush"     Value="{DynamicResource BorderSubtleBrush}"/>
              <Setter Property="BorderThickness" Value="1"/>
              <Setter Property="CornerRadius"    Value="12"/>
              <Setter Property="Padding"         Value="12,10"/>
              <Setter Property="Margin"          Value="0,0,0,8"/>
              <Setter Property="SnapsToDevicePixels" Value="True"/>
              <Style.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                      <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}"/>
                      <Setter Property="Background"  Value="{DynamicResource BgElevatedBrush}"/>
                  </Trigger>
              </Style.Triggers>
          </Style>

          <Style x:Key="EntranceCard" TargetType="Border" BasedOn="{StaticResource GlassCard}">
              <Setter Property="Opacity" Value="0"/>
              <Setter Property="RenderTransform">
                  <Setter.Value>
                      <TranslateTransform Y="16"/>
                  </Setter.Value>
              </Setter>
              <Style.Triggers>
                  <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                      <BeginStoryboard>
                          <Storyboard>
                              <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.5"
                                               EasingFunction="{StaticResource EaseOut}"/>
                              <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y" To="0" Duration="0:0:0.55"
                                               EasingFunction="{StaticResource SmoothEaseOut}"/>
                          </Storyboard>
                      </BeginStoryboard>
                  </EventTrigger>
              </Style.Triggers>
          </Style>

          <Style x:Key="EntrancePanel" TargetType="Border" BasedOn="{StaticResource RedSunCard}">
              <Setter Property="Opacity" Value="0"/>
              <Setter Property="RenderTransform">
                  <Setter.Value>
                      <TranslateTransform Y="16"/>
                  </Setter.Value>
              </Setter>
              <Style.Triggers>
                  <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                      <BeginStoryboard>
                          <Storyboard>
                              <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.5"
                                               EasingFunction="{StaticResource EaseOut}"/>
                              <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y" To="0" Duration="0:0:0.55"
                                               EasingFunction="{StaticResource SmoothEaseOut}"/>
                          </Storyboard>
                      </BeginStoryboard>
                  </EventTrigger>
              </Style.Triggers>
          </Style>

          <Style x:Key="ScrollThumbStyle" TargetType="Thumb">
              <Setter Property="Template">
                  <Setter.Value>
                      <ControlTemplate TargetType="Thumb">
                          <Border x:Name="Bd" Background="#26FFFFFF" CornerRadius="4" Margin="1,2"/>
                          <ControlTemplate.Triggers>
                              <Trigger Property="IsMouseOver" Value="True">
                                  <Setter TargetName="Bd" Property="Background" Value="#4DFFFFFF"/>
                              </Trigger>
                              <Trigger Property="IsDragging" Value="True">
                                  <Setter TargetName="Bd" Property="Background" Value="#8CFF6B35"/>
                              </Trigger>
                          </ControlTemplate.Triggers>
                      </ControlTemplate>
                  </Setter.Value>
              </Setter>
          </Style>

          <Style TargetType="Thumb" BasedOn="{StaticResource ScrollThumbStyle}"/>

          <Style TargetType="ScrollBar">
              <Setter Property="Width" Value="10"/>
              <Setter Property="Background" Value="Transparent"/>
              <Setter Property="Template">
                  <Setter.Value>
                      <ControlTemplate TargetType="ScrollBar">
                          <Grid x:Name="Root" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                              <Track x:Name="PART_Track" IsDirectionReversed="True">
                                  <Track.DecreaseRepeatButton>
                                      <RepeatButton Command="{x:Static ScrollBar.LineUpCommand}" Visibility="Collapsed"/>
                                  </Track.DecreaseRepeatButton>
                                  <Track.Thumb>
                                      <Thumb Style="{StaticResource ScrollThumbStyle}"/>
                                  </Track.Thumb>
                                  <Track.IncreaseRepeatButton>
                                      <RepeatButton Command="{x:Static ScrollBar.LineDownCommand}" Visibility="Collapsed"/>
                                  </Track.IncreaseRepeatButton>
                              </Track>
                          </Grid>
                          <ControlTemplate.Triggers>
                              <Trigger Property="Orientation" Value="Horizontal">
                                  <Setter TargetName="Root" Property="LayoutTransform">
                                      <Setter.Value>
                                          <RotateTransform Angle="-90"/>
                                      </Setter.Value>
                                  </Setter>
                                  <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                              </Trigger>
                          </ControlTemplate.Triggers>
                      </ControlTemplate>
                  </Setter.Value>
              </Setter>
              <Style.Triggers>
                  <Trigger Property="Orientation" Value="Horizontal">
                      <Setter Property="Width" Value="Auto"/>
                      <Setter Property="Height" Value="10"/>
                  </Trigger>
              </Style.Triggers>
          </Style>

          <Style TargetType="ToolTip">
              <Setter Property="Background" Value="#F0161A22"/>
              <Setter Property="BorderBrush" Value="#33FFFFFF"/>
              <Setter Property="BorderThickness" Value="1"/>
              <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
              <Setter Property="FontSize" Value="11"/>
              <Setter Property="Padding" Value="10,6"/>
              <Setter Property="Template">
                  <Setter.Value>
                      <ControlTemplate TargetType="ToolTip">
                          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9"
                                  Padding="{TemplateBinding Padding}">
                              <Border.Effect>
                                  <DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.5"/>
                              </Border.Effect>
                              <ContentPresenter/>
                          </Border>
                      </ControlTemplate>
                  </Setter.Value>
              </Setter>
          </Style>

      </ResourceDictionary>
  </Application.Resources>
</Application>
