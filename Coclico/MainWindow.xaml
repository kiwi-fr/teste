<?xml version="1.0" encoding="utf-8"?>
<ui:FluentWindow x:Class="Coclico.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:Coclico.Views"
        Title="{DynamicResource App_Title}" Height="820" Width="1240"
        Loaded="MainWindow_Loaded"
        MinHeight="660" MinWidth="980"
        Icon="Resources\icone\plage.ico"
        Background="{DynamicResource BgBaseBrush}"
        BorderBrush="{DynamicResource BorderSubtleBrush}"
        BorderThickness="1"
        Opacity="0"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="None"
        WindowState="Normal"
        RenderOptions.BitmapScalingMode="Linear"
        RenderOptions.ClearTypeHint="Enabled"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <Duration x:Key="NavDuration">0:0:0.15</Duration>
        <Storyboard x:Key="AmbientStoryboard" Timeline.DesiredFrameRate="30">
            <DoubleAnimation Storyboard.TargetName="AmbientBlueTransform" Storyboard.TargetProperty="X"
                             From="-60" To="80" Duration="0:0:12" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="AmbientVioletTransform" Storyboard.TargetProperty="Y"
                             From="40" To="-80" Duration="0:0:15" AutoReverse="True" RepeatBehavior="Forever"/>
            <DoubleAnimation Storyboard.TargetName="AmbientRoseTransform" Storyboard.TargetProperty="X"
                             From="70" To="-70" Duration="0:0:18" AutoReverse="True" RepeatBehavior="Forever"/>
        </Storyboard>
        <Storyboard x:Key="PageInStoryboard">
            <DoubleAnimation Storyboard.TargetName="PageContentTransform"
                             Storyboard.TargetProperty="Y"
                             From="16" To="0"
                             Duration="{StaticResource MotionPage}"
                             EasingFunction="{StaticResource EaseOut}"/>
            <DoubleAnimation Storyboard.TargetName="MainContentFrame"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1"
                             Duration="{StaticResource MotionPage}"
                             EasingFunction="{StaticResource EaseOut}"/>
        </Storyboard>
    </Window.Resources>


    <Border Background="{DynamicResource BgBaseBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="28"/>
            </Grid.RowDefinitions>

            <Canvas Grid.RowSpan="5" IsHitTestVisible="False" ClipToBounds="True" Opacity="0.42">
                <Ellipse Width="620" Height="400" Canvas.Left="-160" Canvas.Top="-200">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#FF3B30" Offset="0"/>
                            <GradientStop Color="#4A110D" Offset="0.45"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="AmbientBlueTransform"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Width="560" Height="420" Canvas.Left="420" Canvas.Top="-200">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#FF6B35" Offset="0"/>
                            <GradientStop Color="#451C0A" Offset="0.42"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="AmbientVioletTransform"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Width="500" Height="340" Canvas.Left="980" Canvas.Top="320">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#FFA000" Offset="0"/>
                            <GradientStop Color="#3D2100" Offset="0.4"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="AmbientRoseTransform"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Canvas>

            <ui:TitleBar x:Name="TitleBar" Grid.Row="0"
                         Title="{DynamicResource App_Title}"
                         ShowMaximize="True" ShowMinimize="True">
                <ui:TitleBar.Header>
                    <StackPanel Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center">
                        <ui:Button x:Name="BtnElevateAdmin" Appearance="Transparent"
                                   ToolTip="{DynamicResource Main_AdminStandardTip}"
                                   Click="BtnElevateAdmin_Click" Padding="8,4" Margin="0,0,6,0"
                                   Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Shield24" FontSize="14" Foreground="{DynamicResource ArchitecturalYellowBrush}"/>
                                <TextBlock Text="Admin" FontSize="11" Margin="5,0,0,0" Foreground="{DynamicResource ArchitecturalYellowBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ui:Button>
                        <ui:Button x:Name="UpdateCheckButton" Appearance="Transparent"
                                   ToolTip="{DynamicResource Main_CheckUpdatesTip}"
                                   Click="UpdateCheckButton_Click" Padding="6" Margin="0,0,4,0">
                            <ui:SymbolIcon Symbol="ArrowSync24" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </ui:Button>
                        <ui:Button Appearance="Transparent" ToolTip="{DynamicResource Profile_Title}"
                                   Click="ProfileBorder_MouseDown" Padding="6">
                            <ui:SymbolIcon Symbol="Person24" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </ui:Button>
                    </StackPanel>
                </ui:TitleBar.Header>
            </ui:TitleBar>

            <Border Grid.Row="1" Background="{DynamicResource BgPanelBrush}" Padding="18,8,18,8"
                    MouseDown="TopNavigationBar_MouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Click="BtnArchitecturalMenu_Click"
                                Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                Padding="10,6" Cursor="Hand" Margin="0,0,14,0" ToolTip="{DynamicResource Main_OpenMenuTip}">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="10"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel VerticalAlignment="Center" Margin="0,0,7,0">
                                    <Border Width="16" Height="2" Background="{DynamicResource ArchitecturalYellowBrush}" CornerRadius="1" Margin="0,0,0,3"/>
                                    <Border Width="11" Height="2" Background="#FFFFFF" CornerRadius="1" Margin="0,0,0,3" HorizontalAlignment="Left"/>
                                    <Border Width="16" Height="2" Background="#FFFFFF" CornerRadius="1"/>
                                </StackPanel>
                                <TextBlock Text="{DynamicResource Main_Menu}" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                                <ui:SymbolIcon Symbol="ChevronDown24" FontSize="11" Foreground="{DynamicResource ArchitecturalYellowBrush}" Margin="5,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <TextBlock Text="Coclico" FontSize="17" FontWeight="Bold" FontFamily="Georgia" FontStyle="Italic" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <Border Width="4" Height="4" CornerRadius="2" Background="{DynamicResource ArchitecturalYellowBrush}" Margin="6,0,8,0" VerticalAlignment="Center"/>
                    </StackPanel>


                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Click="BtnNotifications_Click"
                                Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                Padding="9,5" Cursor="Hand" Margin="0,0,8,0" ToolTip="{DynamicResource Notifications_Tooltip}">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="10"/>
                                </Style>
                            </Button.Resources>
                            <Grid>
                                <ui:SymbolIcon Symbol="Alert24" FontSize="13" Foreground="{DynamicResource ArchitecturalYellowBrush}"/>
                                <Border x:Name="NotificationsBadgeBorder" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Width="16" Height="16" CornerRadius="12" Background="{DynamicResource DangerBrush}"
                                        BorderBrush="{DynamicResource BgElevatedBrush}" BorderThickness="1" Margin="0,-6,-6,0" Visibility="Collapsed">
                                    <TextBlock x:Name="NotificationsBadgeText" Text="" FontSize="9" FontWeight="Bold"
                                               Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Button>

                        <Button x:Name="BtnToggleWindowMode" Click="BtnToggleWindowMode_Click"
                                Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                Padding="10,5" Cursor="Hand" Margin="0,0,8,0" ToolTip="{DynamicResource Main_ToggleFullscreenTip}">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="10"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon x:Name="IconWindowMode" Symbol="FullScreenMaximize24" FontSize="13" Foreground="{DynamicResource ArchitecturalYellowBrush}" Margin="0,0,6,0"/>
                                <TextBlock x:Name="TxtWindowMode" Text="{DynamicResource Main_Fullscreen}" FontSize="10.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </StackPanel>
                        </Button>

                        <Button Click="BtnAiChat_Click"
                                Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                Padding="10,5" Cursor="Hand" ToolTip="{DynamicResource Main_CopilotTip}">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="10"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Bot24" FontSize="13" Foreground="{DynamicResource ArchitecturalYellowBrush}" Margin="0,0,6,0"/>
                                <TextBlock Text="{DynamicResource Main_CopilotButton}" FontSize="10.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" Background="{DynamicResource BorderSubtleBrush}"/>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                <Grid>
                    <Border Background="{DynamicResource BgBaseBrush}">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="PageContentTransform"/>
                        </Border.RenderTransform>
                        <ContentControl x:Name="MainContentFrame"/>
                    </Border>

                    <Button x:Name="BtnFloatingAi"
                            Click="BtnFloatingAi_Click"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,0,24,24"
                            Width="44" Height="44"
                            Panel.ZIndex="90"
                            Cursor="Hand"
                            ToolTip="{DynamicResource Main_CopilotFloatingTip}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="FabBorder" CornerRadius="12"
                                        Background="{DynamicResource BgElevatedBrush}"
                                        BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1.2"
                                        SnapsToDevicePixels="True">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270"
                                                          Color="#000000" Opacity="0.5"/>
                                    </Border.Effect>
                                    <ui:SymbolIcon Symbol="Bot24" FontSize="20" Foreground="{DynamicResource ArchitecturalAmberBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="FabBorder" Property="Background" Value="{DynamicResource BgHoverBrush}"/>
                                        <Setter TargetName="FabBorder" Property="BorderBrush" Value="{DynamicResource BorderAccentBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Border x:Name="AiChatOverlay"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Stretch"
                            Panel.ZIndex="100"
                            Visibility="Collapsed"
                            Width="490"
                            MinWidth="400"
                            Margin="0,0,0,0"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1,0,0,0"
                            Background="{DynamicResource BgPanelBrush}">
                        <Border.RenderTransform>
                            <TranslateTransform X="540"/>
                        </Border.RenderTransform>
                        <views:AiChatView
                                          CloseRequested="AiChatPanel_CloseRequested"
                                          ActionRequested="AiChatPanel_ActionRequested"/>
                    </Border>
                </Grid>
            </Grid>

            <Grid x:Name="ArchitecturalDropdownOverlay" Grid.Row="3" Grid.RowSpan="2" Panel.ZIndex="800" Visibility="Collapsed" Opacity="0">
                <Border Background="#E008090C" MouseDown="DropdownBackdrop_MouseDown"/>

                <Border VerticalAlignment="Top" HorizontalAlignment="Left" Width="380"
                    Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1" CornerRadius="0,0,14,14" Padding="18,18,18,20">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.55"/>
                    </Border.Effect>
                    <Border.CacheMode>
                        <BitmapCache RenderAtScale="1"/>
                    </Border.CacheMode>
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="DropdownTranslate" Y="-200"/>
                    </Border.RenderTransform>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="4" Height="16" Background="{DynamicResource ArchitecturalYellowBrush}" CornerRadius="2" Margin="0,0,10,0"/>
                                <TextBlock Text="{DynamicResource Menu_DrawerTitle}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Button Grid.Column="2" Click="DropdownClose_Click"
                                    Background="Transparent" BorderThickness="1" BorderBrush="{DynamicResource BorderDefaultBrush}"
                                    Padding="12,5" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="10"/>
                                    </Style>
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,6,0"/>
                                    <TextBlock Text="{DynamicResource Common_Close}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Border Grid.Row="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,0,0,18"/>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="560">
                        <StackPanel Margin="0,0,2,0">

                            <Border Tag="Home" MouseDown="DropdownItem_MouseDown" Cursor="Hand" Margin="6,0,6,4" Padding="12,10"
                                    Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Home24" FontSize="13" Foreground="{DynamicResource ArchitecturalYellowBrush}" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Menu_Dashboard}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Tag="Applications" MouseDown="MenuGroupToggle_MouseDown" Cursor="Hand"
                                    Margin="6,10,6,0" Padding="12,9"
                                    Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="3" Height="13" Background="{DynamicResource ArchitecturalYellowBrush}" CornerRadius="1.5" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource Menu_GroupApplications}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <ui:SymbolIcon x:Name="MenuChevronApplications" Grid.Column="1" Symbol="ChevronDown24" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                        <ui:SymbolIcon.RenderTransform>
                                            <RotateTransform Angle="0"/>
                                        </ui:SymbolIcon.RenderTransform>
                                    </ui:SymbolIcon>
                                </Grid>
                            </Border>
                            <StackPanel x:Name="MenuPanelApplications" Margin="14,6,6,2">
                                <Border Tag="Programs" MouseDown="DropdownItem_MouseDown" Cursor="Hand" Margin="0,0,0,4" Padding="12,10"
                                        Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Apps24" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource Menu_Applications}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Tag="Installer" MouseDown="DropdownItem_MouseDown" Cursor="Hand" Margin="0,0,0,4" Padding="12,10"
                                        Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource Menu_WingetInstaller}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Tag="UpdateCenter" MouseDown="DropdownItem_MouseDown" Cursor="Hand" Margin="0,0,0,4" Padding="12,10"
                                        Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="ArrowSync24" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource Menu_UpdateCenter}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <Border Tag="Maintenance" MouseDown="MenuGroupToggle_MouseDown" Cursor="Hand"
                                    Margin="6,8,6,0" Padding="12,9"
                                    Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="3" Height="13" Background="{DynamicResource ArchitecturalYellowBrush}" CornerRadius="1.5" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource Menu_GroupMaintenance}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <ui:SymbolIcon x:Name="MenuChevronMaintenance" Grid.Column="1" Symbol="ChevronDown24" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                        <ui:SymbolIcon.RenderTransform>
                                            <RotateTransform Angle="0"/>
                                        </ui:SymbolIcon.RenderTransform>
                                    </ui:SymbolIcon>
                                </Grid>
                            </Border>
                            <StackPanel x:Name="MenuPanelMaintenance" Margin="14,6,6,2">
                                <Border Tag="Cleaning" MouseDown="DropdownItem_MouseDown" Cursor="Hand" Margin="0,0,0,4" Padding="12,10"
                                        Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Delete24" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource Menu_SystemCleaning}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Tag="TelemetryBlocker" MouseDown="DropdownItem_MouseDown" Cursor="Hand" Margin="0,0,0,4" Padding="12,10"
                                        Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Shield24" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource Menu_TelemetryBlocker}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Tag="HealthDefense" MouseDown="DropdownItem_MouseDown" Cursor="Hand" Margin="0,0,0,4" Padding="12,10"
                                        Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource Menu_HealthAndDefense}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Tag="DiskAnalyzer" MouseDown="DropdownItem_MouseDown" Cursor="Hand" Margin="0" Padding="12,10"
                                        Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="DataUsage24" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource Menu_DiskAnalyzer}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

<Border Tag="Performance" MouseDown="MenuGroupToggle_MouseDown" Cursor="Hand"
                                    Margin="6,10,6,0" Padding="12,9"
                                    Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="3" Height="13" Background="{DynamicResource ArchitecturalYellowBrush}" CornerRadius="1.5" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource Menu_GroupPerformance}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <ui:SymbolIcon x:Name="MenuChevronPerformance" Grid.Column="1" Symbol="ChevronDown24" FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                        <ui:SymbolIcon.RenderTransform>
                                            <RotateTransform Angle="0"/>
                                        </ui:SymbolIcon.RenderTransform>
                                    </ui:SymbolIcon>
                                </Grid>
                            </Border>
                            <StackPanel x:Name="MenuPanelPerformance" Margin="14,6,6,2">
                                <Border Tag="RamCleaner" MouseDown="DropdownItem_MouseDown" Cursor="Hand" Margin="0,0,0,4" Padding="12,10"
                                        Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Flash24" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource Menu_RamTurboCleaner}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Tag="Network" MouseDown="DropdownItem_MouseDown" Cursor="Hand" Margin="0,0,0,4" Padding="12,10"
                                        Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Globe24" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource Menu_NetworkOptimizer}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <Border Tag="PowerOptimizer" MouseDown="DropdownItem_MouseDown" Cursor="Hand" Margin="0" Padding="12,10"
                                        Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Gauge24" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{DynamicResource Menu_PowerOptimizer}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

<Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="6,12,6,6"/>

                            <Border Tag="Settings" MouseDown="DropdownItem_MouseDown" Cursor="Hand" Margin="6,0,6,4" Padding="12,10"
                                    Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Settings24" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Menu_Settings}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <Border Tag="Help" MouseDown="DropdownItem_MouseDown" Cursor="Hand" Margin="6,0,6,0" Padding="12,10"
                                    Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="QuestionCircle24" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,9,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Menu_HelpAndAi}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="4" Background="{DynamicResource BgPanelBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource SuccessBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="Coclico" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="{DynamicResource Status_SystemReady}"
                               FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <TextBlock x:Name="VersionText" Grid.Column="2" Text=""
                               FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                               FontWeight="Medium" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <ui:SnackbarPresenter x:Name="RootSnackbarPresenter"
                                  Grid.Row="3" Panel.ZIndex="9999"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Bottom"
                                  Margin="0,0,0,24"/>

            <Grid x:Name="NotificationsOverlay" Grid.Row="2" Grid.RowSpan="3" Panel.ZIndex="850" Visibility="Collapsed" Opacity="0">
                <Border Background="#E008090C" MouseDown="NotificationsBackdrop_MouseDown"/>

                <Border VerticalAlignment="Top" HorizontalAlignment="Right" Width="360" Margin="0,14,18,0"
                        Background="{DynamicResource BgPanelBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="16,16,16,18">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.55"/>
                    </Border.Effect>
                    <Border.CacheMode>
                        <BitmapCache RenderAtScale="1"/>
                    </Border.CacheMode>
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="NotificationsTranslate" Y="-200"/>
                    </Border.RenderTransform>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="1"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="4" Height="16" Background="{DynamicResource ArchitecturalYellowBrush}" CornerRadius="2" Margin="0,0,10,0"/>
                                <TextBlock Text="{DynamicResource Notifications_Title}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <Button Grid.Column="2" Click="NotificationsClose_Click"
                                    Background="Transparent" BorderThickness="1" BorderBrush="{DynamicResource BorderDefaultBrush}"
                                    Padding="12,5" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="10"/>
                                    </Style>
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,6,0"/>
                                    <TextBlock Text="{DynamicResource Common_Close}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Border Grid.Row="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,0,0,14"/>

                        <TextBlock x:Name="NotificationsEmptyText" Grid.Row="2"
                                   Text="{DynamicResource Notifications_Empty}" FontSize="11.5"
                                   Foreground="{DynamicResource TextHintBrush}" HorizontalAlignment="Center"
                                   Margin="0,18,0,18" TextWrapping="Wrap" TextAlignment="Center"/>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="420">
                            <ItemsControl x:Name="NotificationsList" Margin="0,0,2,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,6" Padding="12,10"
                                                Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                BorderThickness="1" CornerRadius="12">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="Bold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Timestamp, StringFormat={}{0:HH:mm}}"
                                                               FontSize="9.5" Foreground="{DynamicResource TextHintBrush}" VerticalAlignment="Center"/>
                                                </Grid>
                                                <TextBlock Grid.Row="1" Text="{Binding Message}" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Button Grid.Row="3" Click="NotificationsClear_Click"
                                Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                                Padding="12,6" Cursor="Hand" Margin="0,4,0,0" HorizontalAlignment="Right">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="10"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Delete24" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,6,0"/>
                                <TextBlock Text="{DynamicResource Notifications_Clear}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <Grid x:Name="WelcomeOverlay" Grid.Row="0" Grid.RowSpan="5" Panel.ZIndex="10000" Visibility="Collapsed" Opacity="0">
                <Border Background="{DynamicResource OverlayDark}" MouseDown="WelcomeBackdrop_MouseDown"/>
                <Border VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="690" Margin="24"
                        Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="1" CornerRadius="16" Padding="32,28">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="WelcomeTransform" Y="0"/>
                    </Border.RenderTransform>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" ShadowDepth="10" Direction="270" Color="#000000" Opacity="0.85"/>
                    </Border.Effect>
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="42" Height="42" CornerRadius="12" Background="{DynamicResource BgElevatedBrush}"
                                    BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Sparkle24" FontSize="20" Foreground="{DynamicResource PrimaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Welcome_Title}" FontSize="21" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{DynamicResource Welcome_HeroTitle}" FontSize="14.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="{DynamicResource Welcome_HeroDesc}" FontSize="12.5" LineHeight="18"
                                   Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,20"/>

                        <UniformGrid Columns="2" Rows="2" Margin="0,0,0,20">
                            <Border Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                                    CornerRadius="14" Padding="14,12" Margin="0,0,6,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="Flash24" FontSize="17" Foreground="{DynamicResource PrimaryBrush}"
                                                   VerticalAlignment="Top" Margin="0,2,10,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{DynamicResource Welcome_Card1_Title}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{DynamicResource Welcome_Card1_Desc}" FontSize="11.5" LineHeight="16"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                                    CornerRadius="14" Padding="14,12" Margin="6,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="Brain24" FontSize="17" Foreground="{DynamicResource SecondaryBrush}"
                                                   VerticalAlignment="Top" Margin="0,2,10,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{DynamicResource Welcome_Card2_Title}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{DynamicResource Welcome_Card2_Desc}" FontSize="11.5" LineHeight="16"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                                    CornerRadius="14" Padding="14,12" Margin="0,6,6,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="Sparkle24" FontSize="17" Foreground="{DynamicResource ArchitecturalYellowBrush}"
                                                   VerticalAlignment="Top" Margin="0,2,10,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{DynamicResource Welcome_Card3_Title}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{DynamicResource Welcome_Card3_Desc}" FontSize="11.5" LineHeight="16"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                                    CornerRadius="14" Padding="14,12" Margin="6,6,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="17" Foreground="{DynamicResource SuccessBrush}"
                                                   VerticalAlignment="Top" Margin="0,2,10,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{DynamicResource Welcome_Card4_Title}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{DynamicResource Welcome_Card4_Desc}" FontSize="11.5" LineHeight="16"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </UniformGrid>

                        <Border Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,0,0,16"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Welcome_Brand}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="{DynamicResource Welcome_Author}" FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <ui:Button x:Name="BtnDismissWelcome" Grid.Column="1" Click="BtnDismissWelcome_Click"
                                       Appearance="Primary" CornerRadius="12" Padding="22,10"
                                       Cursor="Hand" FontWeight="SemiBold" IsDefault="True">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource Welcome_Action}" FontSize="13" VerticalAlignment="Center"/>
                                    <ui:SymbolIcon Symbol="ArrowRight24" FontSize="14" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ui:Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</ui:FluentWindow>
