<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\icone\plage.ico</ApplicationIcon>
    <Company>Coclico</Company>
    <Product>Coclico</Product>
    <Description>Windows desktop application for system information and maintenance tools.</Description>
    <Copyright>© $([System.DateTime]::UtcNow.Year) Coclico</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
    <SatelliteResourceLanguages>fr;en</SatelliteResourceLanguages>
    <TieredPGO>true</TieredPGO>
    <TieredCompilation>true</TieredCompilation>
    <OptimizationPreference>Speed</OptimizationPreference>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <PublishTrimmed>false</PublishTrimmed>

    <!-- Aucune API WinRT utilisée : évite de embarquer Microsoft.Windows.SDK.NET.dll (~25 Mo) -->
    <IncludeWindowsSDKRefFrameworkReferences>false</IncludeWindowsSDKRefFrameworkReferences>
    <!-- Aucune projection WinRT utilisee dans le code : la validation du SDK Windows du MVVM Toolkit est sans objet -->
    <MvvmToolkitEnableWindowsSdkPackageVersionValidation>false</MvvmToolkitEnableWindowsSdkPackageVersionValidation>

    <PublishReadyToRun Condition="'$(RuntimeIdentifier)' == 'win-x64'">true</PublishReadyToRun>
    <InvariantGlobalization>false</InvariantGlobalization>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\icone\plage.ico" />
    <Resource Include="Resources\icone\plage.png" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Security\trust-policy.json">
      <LogicalName>Coclico.Security.trust-policy.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Coclico.Security\Coclico.Security.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Modules\Apps\Assets\apps.json">
      <LogicalName>Coclico.apps.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Modules\Apps\Assets\apppacks.json">
      <LogicalName>Coclico.apppacks.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Coclico.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LLamaSharp" Version="0.30.0" />
    <PackageReference Include="LLamaSharp.Backend.Cpu" Version="0.26.0" />
    <PackageReference Include="Meziantou.Analyzer" Version="3.0.339">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.14" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="SecurityCodeScan.VS2019" Version="5.6.7">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="System.Management" Version="10.0.14" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.14" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="System.Reactive" Version="6.0.1" />
  </ItemGroup>

  <ItemGroup Condition="'$(IncludeCuda)' == 'true'">
    <PackageReference Include="LLamaSharp.Backend.Cuda12" Version="0.26.0" />
    <PackageReference Include="NtvLibs.cuda12.cudart64_12.runtime.win-x64" Version="12.8.1" />
    <PackageReference Include="NtvLibs.cuda12.cublas.runtime.win-x64" Version="12.8.1" />
  </ItemGroup>


  <Target Name="RemoveNonWindowsRuntimeAssetsFromWindowsPublish" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <RemoveDir Directories="$(PublishDir)runtimes\linux-x64" />
    <!-- On n'embarque que les variantes avx2 et noavx des DLL natives IA (le build avx2 tourne aussi sur CPU AVX-512) -->
    <RemoveDir Directories="$(PublishDir)runtimes\win-x64\native\avx;$(PublishDir)runtimes\win-x64\native\avx512" />
  </Target>

  <!-- En publish single-file, le bundling a lieu dans Publish : retirer avx/avx512 des fichiers resolus AVANT GenerateBundle -->
  <Target Name="RemoveAvxVariantsBeforeBundle" BeforeTargets="GenerateBundle" Condition="'$(RuntimeIdentifier)' == 'win-x64' And '$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.RelativePath)' Contains 'runtimes\win-x64\native\avx\' Or '%(ResolvedFileToPublish.RelativePath)' Contains 'runtimes\win-x64\native\avx512\'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Content Include="..\extension\**\*.*">
      <Link>extension\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
