<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Coclico.Modules.UpdateCenter.Views.UpdateCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:Coclico.Modules.UpdateCenter.ViewModels">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <LinearGradientBrush x:Key="UpdateAnimBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#FF9500" Offset="0"/>
            <GradientStop Color="#FF3B30" Offset="0.5"/>
            <GradientStop Color="#AF52DE" Offset="1"/>
        </LinearGradientBrush>
    </UserControl.Resources>
    <Grid Background="{DynamicResource BgBaseBrush}" Margin="{DynamicResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                    <Border Style="{StaticResource PageEyebrowDot}"/>
                    <TextBlock Text="{DynamicResource Menu_UpdateCenter}" Style="{StaticResource PageEyebrow}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource PageHeaderAccentBar}" Height="30"/>
                    <TextBlock Text="{DynamicResource UpdateCenter_Title}" Style="{StaticResource CoclicoPageTitle}"/>
                </StackPanel>
                <TextBlock Text="{Binding LastScanSummary}" Style="{StaticResource PageHeaderSubtitle}" Margin="16,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Grid Width="220" Margin="0,0,10,0" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Search24" FontSize="13" Foreground="{DynamicResource TextHintBrush}"
                                   HorizontalAlignment="Left" Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    <TextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Padding="30,7,8,7"
                             VerticalContentAlignment="Center"/>
                </Grid>
                <Button Content="{DynamicResource UpdateCenter_CheckAll}"
                        Command="{Binding CheckAllCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,10,0"
                        VerticalAlignment="Center"/>
                <Button Content="{DynamicResource UpdateCenter_UpdateSelected}"
                        Command="{Binding UpdateSelectedCommand}"
                        Style="{StaticResource PrimaryButton}"
                        VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1">
            <ProgressBar Height="4" IsIndeterminate="True" Margin="0,0,0,6"
                         Foreground="{StaticResource UpdateAnimBrush}">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="Scanning">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Updating">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>
            <TextBlock FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,10">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Text" Value=""/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="Scanning">
                                <Setter Property="Text" Value="{DynamicResource UpdateCenter_Scanning}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="Updating">
                                <Setter Property="Text" Value="{DynamicResource UpdateCenter_Updating}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <ItemsControl Grid.Row="2" ItemsSource="{Binding Sections}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:UpdateSectionViewModel}">
                    <Expander IsExpanded="{Binding IsExpanded}" Margin="0,0,0,8">
                        <Expander.Header>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" Margin="8,0,0,0">
                                    <Run Text="{Binding AvailableCount, Mode=OneWay}"/>
                                    <Run Text="{DynamicResource UpdateCenter_AvailableSuffix}"/>
                                </TextBlock>
                                <ProgressBar DockPanel.Dock="Right" Width="16" Height="16"
                                             IsIndeterminate="True"
                                             Foreground="{StaticResource UpdateAnimBrush}"
                                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15"/>
                            </DockPanel>
                        </Expander.Header>
                        <ItemsControl ItemsSource="{Binding Items}" Margin="24,8,0,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:UpdateItemViewModel}">
                                    <StackPanel Margin="0,4">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding StatusLabel}" Foreground="{DynamicResource TextMutedBrush}" Margin="12,0,0,0"/>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding SourceLabel}" Foreground="{DynamicResource TextHintBrush}" Margin="12,0,0,0"/>
                                            <TextBlock DockPanel.Dock="Right" Foreground="{DynamicResource TextSecondaryBrush}" Margin="12,0,0,0">
                                                <Run Text="{Binding CurrentVersion, Mode=OneWay}"/><Run Text=" → "/><Run Text="{Binding AvailableVersion, Mode=OneWay}"/>
                                            </TextBlock>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding IsSelectable}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>

                                        <ProgressBar Height="3" IsIndeterminate="True" Margin="0,3,0,0"
                                                     Foreground="{StaticResource UpdateAnimBrush}">
                                            <ProgressBar.Style>
                                                <Style TargetType="ProgressBar">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Updating">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ProgressBar.Style>
                                        </ProgressBar>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
