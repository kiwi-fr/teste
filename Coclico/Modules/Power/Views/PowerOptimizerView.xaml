<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Coclico.Modules.Power.Views.PowerOptimizerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Grid Background="{DynamicResource BgBaseBrush}" Margin="{DynamicResource PageMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6" VerticalAlignment="Center">
                    <Border Style="{StaticResource PageEyebrowDot}"/>
                    <TextBlock Text="{DynamicResource Power_Eyebrow}" Style="{StaticResource PageEyebrow}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource PageHeaderAccentBar}" Height="30"/>
                    <TextBlock Text="{DynamicResource Power_Title}" Style="{StaticResource CoclicoPageTitle}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="16,4,0,0">
                    <TextBlock Text="{DynamicResource Power_Subtitle}"
                               Style="{StaticResource PageHeaderSubtitle}" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border CornerRadius="{StaticResource CornerSmall}" Padding="10,5" Background="{DynamicResource BgElevatedBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon x:Name="AdminChipIcon" Symbol="Shield24" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="AdminChipText" Text="..." FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border CornerRadius="{StaticResource CornerSmall}" Padding="10,5" Margin="8,0,0,0" Background="{DynamicResource BgElevatedBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="BatteryCharge24" FontSize="12" Foreground="{DynamicResource PrimaryBrush}"/>
                        <TextBlock x:Name="ActivePlanText" Text="{DynamicResource Power_PlanLabel}" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,24">
            <StackPanel MaxWidth="980" HorizontalAlignment="Left">

                <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1" CornerRadius="{StaticResource CornerCard}" Padding="20,16" Margin="0,0,0,14">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Power_PlansTitle}" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{DynamicResource Power_PlansDesc}"
                                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            </StackPanel>
                            <Button x:Name="BtnCreatePlans" Grid.Column="1" Click="BtnCreatePlans_Click" Cursor="Hand"
                                    Background="{DynamicResource PrimaryBrush}" Foreground="{DynamicResource ArchitecturalDarkTextBrush}" FontWeight="SemiBold"
                                    FontSize="11.5" Padding="16,8" Margin="16,0,0,0" VerticalAlignment="Center">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="{StaticResource CornerBtn}"/>
                                    </Style>
                                </Button.Resources>
                                Créer / auto-configurer
                            </Button>
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" x:Name="CardEconomy" Background="{DynamicResource BgSurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="{StaticResource CornerCard}" Padding="14,12">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="BatterySaver24" FontSize="16" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource Power_PlanEconomy}" FontSize="13" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="StatusEconomy" Text="{DynamicResource Power_StatusAbsent}" FontSize="9.5" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="{DynamicResource Power_PlanEconomyDesc}"
                                               FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,7,0,10"/>
                                    <Button Click="BtnActivateEconomy_Click" Cursor="Hand"
                                            Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}"
                                            BorderThickness="1" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" Padding="12,6"
                                            HorizontalAlignment="Left">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="{StaticResource CornerSmall}"/>
                                            </Style>
                                        </Button.Resources>
                                        Activer
                                    </Button>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" x:Name="CardOptimal" Background="{DynamicResource BgSurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="{StaticResource CornerCard}" Padding="14,12">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Gauge24" FontSize="16" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource Power_PlanOptimal}" FontSize="13" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="StatusOptimal" Text="{DynamicResource Power_StatusAbsent}" FontSize="9.5" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="{DynamicResource Power_PlanOptimalDesc}"
                                               FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,7,0,10"/>
                                    <Button Click="BtnActivateOptimal_Click" Cursor="Hand"
                                            Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}"
                                            BorderThickness="1" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" Padding="12,6"
                                            HorizontalAlignment="Left">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="{StaticResource CornerSmall}"/>
                                            </Style>
                                        </Button.Resources>
                                        Activer
                                    </Button>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="4" x:Name="CardPerformance" Background="{DynamicResource BgSurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="{StaticResource CornerCard}" Padding="14,12">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Symbol="Flash24" FontSize="16" Foreground="{DynamicResource ArchitecturalYellowBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{DynamicResource Power_PlanPerformance}" FontSize="13" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="StatusPerformance" Text="{DynamicResource Power_StatusAbsent}" FontSize="9.5" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="{DynamicResource Power_PlanPerformanceDesc}"
                                               FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,7,0,10"/>
                                    <Button Click="BtnActivatePerformance_Click" Cursor="Hand"
                                            Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}"
                                            BorderThickness="1" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" Padding="12,6"
                                            HorizontalAlignment="Left">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="{StaticResource CornerSmall}"/>
                                            </Style>
                                        </Button.Resources>
                                        Activer
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="PlansReportText" Text="" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Click="BtnDeletePlans_Click" Cursor="Hand"
                                    Background="Transparent" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                    Foreground="{DynamicResource DangerBrush}" FontSize="10.5" Padding="10,5" VerticalAlignment="Center">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="{StaticResource CornerSmall}"/>
                                    </Style>
                                </Button.Resources>
                                Supprimer les plans Coclico
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1" CornerRadius="{StaticResource CornerCard}" Padding="20,16" Margin="0,0,0,14">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="DesktopPulse24" FontSize="15" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Power_AdaptiveTitle}" FontSize="11" FontWeight="Bold"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{DynamicResource Power_AdaptiveDesc}"
                                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            </StackPanel>
                            <Button x:Name="BtnToggleAdaptive" Grid.Column="1" Click="BtnToggleAdaptive_Click" Cursor="Hand"
                                    Background="{DynamicResource PrimaryBrush}" Foreground="{DynamicResource ArchitecturalDarkTextBrush}" FontWeight="SemiBold"
                                    FontSize="11.5" Padding="16,8" Margin="16,0,0,0" VerticalAlignment="Center">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="{StaticResource CornerBtn}"/>
                                    </Style>
                                </Button.Resources>
                                Activer
                            </Button>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Charge CPU actuelle" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <Grid Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ProgressBar x:Name="CpuUsageBar" Height="6" Maximum="100" Value="0" BorderThickness="0"
                                             Background="{DynamicResource BgElevatedBrush}" Foreground="{DynamicResource PrimaryBrush}"
                                             VerticalAlignment="Center"/>
                                <TextBlock x:Name="CpuUsageText" Grid.Column="1" Text="-" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="10,0,0,0" VerticalAlignment="Center" Width="44"/>
                            </Grid>
                        </Grid>
                        <TextBlock x:Name="AdaptiveStatusText" Text="{DynamicResource Power_AdaptiveIdle}" FontSize="10.5"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1" CornerRadius="{StaticResource CornerCard}" Padding="20,16" Margin="0,0,0,14">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="FlashSettings24" FontSize="15" Foreground="{DynamicResource ArchitecturalYellowBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{DynamicResource Power_TestTitle}" FontSize="11" FontWeight="Bold"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{DynamicResource Power_TestDesc}"
                                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            </StackPanel>
                            <Button x:Name="BtnRunBenchmark" Grid.Column="1" Click="BtnRunBenchmark_Click" Cursor="Hand"
                                    Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                                    Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="11.5"
                                    Padding="16,8" Margin="16,0,0,0" VerticalAlignment="Center">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="{StaticResource CornerBtn}"/>
                                    </Style>
                                </Button.Resources>
                                Lancer le test
                            </Button>
                        </Grid>

                        <ProgressBar x:Name="BenchmarkProgress" Height="6" IsIndeterminate="False" Minimum="0" Maximum="100" Value="0"
                                     BorderThickness="0" Margin="0,12,0,0" Background="{DynamicResource BgElevatedBrush}"
                                     Foreground="{DynamicResource PrimaryBrush}" Visibility="Collapsed"/>
                        <StackPanel x:Name="BenchmarkResults" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1" CornerRadius="{StaticResource CornerCard}" Padding="20,16" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="BatteryCharge24" FontSize="15" Foreground="{DynamicResource ArchitecturalYellowBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Power_BatteryTitle}" FontSize="11" FontWeight="Bold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{DynamicResource Power_BatteryDesc}"
                                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Click="BtnBatteryReport_Click" Cursor="Hand"
                                Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                                Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="11.5"
                                Padding="16,8" Margin="16,0,0,0" VerticalAlignment="Center"
                                AutomationProperties.Name="{DynamicResource Power_A11y_BatteryReport}">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="{StaticResource CornerBtn}"/>
                                </Style>
                            </Button.Resources>
                            Générer le rapport
                        </Button>
                    </Grid>
                </Border>

                <TextBlock x:Name="StatusText" Text="" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"
                           TextWrapping="Wrap" Margin="2,0,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
